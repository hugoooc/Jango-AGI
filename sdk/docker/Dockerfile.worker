FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG OPENVSP_VERSION=3.51.0
ARG OPENVSP_DEB_URL=https://openvsp.org/zips/current/linux/OpenVSP-3.51.0-Ubuntu-24.04_amd64.deb

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl desktop-file-utils openbox novnc procps python3 scrot websockify \
      x11-utils x11vnc xdotool xvfb \
    && curl -fL "$OPENVSP_DEB_URL" -o /tmp/openvsp.deb \
    && apt-get install -y --no-install-recommends /tmp/openvsp.deb \
    && rm -f /tmp/openvsp.deb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY container_worker /workspace/container_worker
COPY models /workspace/models
COPY docker/entrypoint.sh /usr/local/bin/openvsp-worker
RUN chmod +x /usr/local/bin/openvsp-worker

ENV DISPLAY=:99 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    PYTHONUNBUFFERED=1 \
    WORKER_PORT=8080

EXPOSE 8080 6080
HEALTHCHECK --interval=10s --timeout=3s --start-period=45s --retries=6 \
  CMD curl -fsS http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/openvsp-worker"]
